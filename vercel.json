{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "env": {
    "KLASSED_JWT_SECRET": "klassed-neet-v2-enterprise-hmac-secret-2026"
  },
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/**,data/**,model/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/auth/(.*)", "destination": "/api/index" },
    { "source": "/students/(.*)", "destination": "/api/index" },
    { "source": "/submit_attempt", "destination": "/api/index" },
    { "source": "/submit_paper", "destination": "/api/index" },
    { "source": "/remediation/(.*)", "destination": "/api/index" },
    { "source": "/mlops/(.*)", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/api/health", "destination": "/api/index" },
    { "source": "/docs", "destination": "/api/index" },
    { "source": "/openapi.json", "destination": "/api/index" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
